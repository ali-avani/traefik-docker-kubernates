# Used by bash ./install.sh. Any value left empty is asked for interactively.
# Copy to .env and fill in for an unattended install: bash ./install.sh --yes

# docker | kubernetes   (kubernetes = Docker provider + Kubernetes providers)
INSTALL_TYPE=

# Domain for the Traefik dashboard, e.g. traefik.example.com
DASHBOARD_DOMAIN=

# Email for Let's Encrypt registration
ACME_EMAIL=

# Dashboard admin account. ADMIN_PASSWORD is only read by the installer, which
# clears it from this file afterwards.
ADMIN_USER=
ADMIN_PASSWORD=

# Traefik image tag
TRAEFIK_VERSION=v3.7

# Optional: image repository, to pull from a mirror
# (default: traefik)
# TRAEFIK_IMAGE=

# Optional: DEBUG | INFO | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO

# --- kubernetes only ---
# Optional: kubectl context to use (default: current context)
KUBECTL_CONTEXT=
# Optional: API server URL written into kubeconfig.yaml (default: from kubectl)
K8S_API_SERVER=

# Set by the installer: which compose files to use
COMPOSE_FILE=
