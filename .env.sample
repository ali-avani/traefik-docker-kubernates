# Used by bash ./install.sh. Empty values are asked for.

# docker (Docker provider) | kubernetes (Docker + Kubernetes providers)
INSTALL_TYPE=

# Dashboard domain, e.g. traefik.example.com
DASHBOARD_DOMAIN=

# Let's Encrypt email
ACME_EMAIL=

# Dashboard admin user. The password is asked for, or passed as ADMIN_PASSWORD in
# the environment. It is never stored.
ADMIN_USER=

# Traefik image tag
TRAEFIK_VERSION=v3.7

# Optional image repository, for a mirror (default: traefik)
# TRAEFIK_IMAGE=

# DEBUG | INFO | WARN | ERROR
TRAEFIK_LOG_LEVEL=INFO

# Kubernetes only: kubectl context (default: current) and API server URL
# KUBECTL_CONTEXT=
# K8S_API_SERVER=

# Set by the installer
COMPOSE_FILE=
