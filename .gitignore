# Environment files
.env

# Kubernetes configuration with sensitive credentials
kubeconfig.yaml

# Let's Encrypt certificates and private keys
letsencrypt/

# Docker volumes and data
data/

# Log files
*.log

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Generated by install.sh (dashboard.yaml contains the password hash) and
# per-server custom files. Examples live in examples/.
dynamic/*
!dynamic/.gitkeep

# Per-server compose customizations (see examples/docker-compose.override.yaml)
docker-compose.override.yaml
